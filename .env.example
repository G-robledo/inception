# make init generates .env and random local passwords automatically.
# Set DOMAIN_NAME to the VM's reachable IPv4 address or DNS name for remote access.
DOMAIN_NAME=localhost
HTTPS_PORT=8443
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_ROOT_PASSWORD=replace-with-a-local-password
MYSQL_PASSWORD=replace-with-a-local-password
WP_ADMIN_USER=siteowner
WP_ADMIN_PASSWORD=replace-with-a-local-password
WP_ADMIN_EMAIL=admin@example.test
WP_USER=reader
WP_USER_PASSWORD=replace-with-a-local-password
WP_USER_EMAIL=reader@example.test
